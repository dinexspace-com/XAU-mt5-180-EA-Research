#property strict
#property version "1.00"
#include <Trade\Trade.mqh>
CTrade trade;
input double InpLotSize=0.01; input int InpStopLoss=300; input int InpTakeProfit=600; input ulong InpMagicNumber=118001; input int InpSlippage=10;
input bool InpUseBreakEven=true; input int InpBreakEvenStart=150; input int InpBreakEvenOffset=0; input bool InpUseTrailingStop=true; input int InpTrailingStart=200; input int InpTrailingDistance=200; input int InpMaxSpread=30;
input int InpAverageBodyPeriod=20; input double InpBodyMultiplier=1.50; input double InpExtremeCloseRatio=0.75; datetime lastbar=0;
int OnInit(){trade.SetExpertMagicNumber(InpMagicNumber);trade.SetDeviationInPoints(InpSlippage);trade.SetTypeFillingBySymbol(_Symbol);return INIT_SUCCEEDED;}void OnDeinit(const int r){}
bool NewBar(){datetime t=iTime(_Symbol,_Period,0);if(t==0||t==lastbar)return false;lastbar=t;return true;}
bool HasPosition(){for(int i=PositionsTotal()-1;i>=0;i--){ulong x=PositionGetTicket(i);if(x&&PositionGetString(POSITION_SYMBOL)==_Symbol&&(ulong)PositionGetInteger(POSITION_MAGIC)==InpMagicNumber)return true;}return false;}
bool SpreadOK(){MqlTick t;if(!SymbolInfoTick(_Symbol,t))return false;return(t.ask-t.bid)/_Point<=InpMaxSpread;}
void ManagePositions(){MqlTick t;if(!SymbolInfoTick(_Symbol,t))return;int d=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);for(int i=PositionsTotal()-1;i>=0;i--){ulong x=PositionGetTicket(i);if(!x||PositionGetString(POSITION_SYMBOL)!=_Symbol||(ulong)PositionGetInteger(POSITION_MAGIC)!=InpMagicNumber)continue;ENUM_POSITION_TYPE ty=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);double o=PositionGetDouble(POSITION_PRICE_OPEN),s=PositionGetDouble(POSITION_SL),tp=PositionGetDouble(POSITION_TP),p=ty==POSITION_TYPE_BUY?t.bid:t.ask,pr=ty==POSITION_TYPE_BUY?(p-o)/_Point:(o-p)/_Point,ns=s;if(InpUseBreakEven&&pr>=InpBreakEvenStart){double b=ty==POSITION_TYPE_BUY?o+InpBreakEvenOffset*_Point:o-InpBreakEvenOffset*_Point;if(ty==POSITION_TYPE_BUY?(ns==0||b>ns):(ns==0||b<ns))ns=b;}if(InpUseTrailingStop&&pr>=InpTrailingStart){double tr=ty==POSITION_TYPE_BUY?p-InpTrailingDistance*_Point:p+InpTrailingDistance*_Point;if(ty==POSITION_TYPE_BUY?(ns==0||tr>ns):(ns==0||tr<ns))ns=tr;}ns=NormalizeDouble(ns,d);if(ns>0&&MathAbs(ns-s)>=_Point&&!trade.PositionModify(x,ns,tp))PrintFormat("PositionModify failed. Ticket=%I64u Retcode=%u",x,trade.ResultRetcode());}}
void OnTick(){ManagePositions();if(!NewBar()||!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)||!MQLInfoInteger(MQL_TRADE_ALLOWED)||HasPosition()||!SpreadOK())return;int n=InpAverageBodyPeriod+2;MqlRates r[];ArraySetAsSeries(r,true);if(CopyRates(_Symbol,_Period,0,n,r)!=n)return;double body=MathAbs(r[1].close-r[1].open),avg=0;for(int i=2;i<n;i++)avg+=MathAbs(r[i].close-r[i].open);avg/=InpAverageBodyPeriod;double range=r[1].high-r[1].low;if(range<=0)return;bool buy=r[1].close>r[1].open&&body>=avg*InpBodyMultiplier&&(r[1].close-r[1].low)/range>=InpExtremeCloseRatio;bool sell=r[1].close<r[1].open&&body>=avg*InpBodyMultiplier&&(r[1].high-r[1].close)/range>=InpExtremeCloseRatio;MqlTick t;if(!SymbolInfoTick(_Symbol,t))return;int d=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);if(buy){double sl=NormalizeDouble(t.ask-InpStopLoss*_Point,d),tp=NormalizeDouble(t.ask+InpTakeProfit*_Point,d);if(!trade.Buy(InpLotSize,_Symbol,t.ask,sl,tp,"EA-118 BUY"))PrintFormat("Buy failed. Retcode=%u",trade.ResultRetcode());}else if(sell){double sl=NormalizeDouble(t.bid+InpStopLoss*_Point,d),tp=NormalizeDouble(t.bid-InpTakeProfit*_Point,d);if(!trade.Sell(InpLotSize,_Symbol,t.bid,sl,tp,"EA-118 SELL"))PrintFormat("Sell failed. Retcode=%u",trade.ResultRetcode());}}
